{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "types/**/*",
    "sdk/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "js/lib",
    "coverage"
  ]
}
