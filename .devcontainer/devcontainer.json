{
  "name": "Copio SDK & Framework Examples",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173, 4200, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server (Vanilla / React / Vue)"
    },
    "4200": {
      "label": "Angular Dev Server"
    },
    "8000": {
      "label": "SDK Sandbox"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "vue.volar",
        "angular.ng-template"
      ]
    }
  }
}
