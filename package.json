{
  "name": "@copio/sdk",
  "version": "0.1.3",
  "description": "Embeddable Web Components and Headless Services for Document Scanning, OCR, Editing, and P2P Sync.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/sdk/index.d.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/types/sdk/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/sdk/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./scanner": {
      "types": "./dist/types/sdk/scanner.d.ts",
      "import": "./dist/scanner.js",
      "default": "./dist/scanner.js"
    },
    "./sync": {
      "types": "./dist/types/sdk/sync.d.ts",
      "import": "./dist/sync.js",
      "default": "./dist/sync.js"
    },
    "./handoff": {
      "types": "./dist/types/sdk/handoff.d.ts",
      "import": "./dist/handoff.js",
      "default": "./dist/handoff.js"
    },
    "./adapters/*": {
      "import": "./dist/adapters/*.js",
      "default": "./dist/adapters/*.js"
    },
    "./styles": "./css/shoelace.css",
    "./styles/*": "./css/*"
  },
  "files": [
    "LICENSE*",
    "THIRD_PARTY_NOTICES.md",
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.json",
    "dist/adapters",
    "dist/types",
    "sdk",
    "css"
  ],
  "sideEffects": [
    "dist/cdn.js",
    "dist/scanner.js",
    "sdk/scanner.js",
    "dist/handoff.js",
    "sdk/handoff.js",
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwilliams/copio.git"
  },
  "homepage": "https://copio.netlify.app",
  "keywords": [
    "copio",
    "scanner",
    "web-components",
    "camera",
    "ocr",
    "pdf",
    "document-scanner",
    "crop",
    "image-processing",
    "pwa"
  ],
  "author": "Ed Williams",
  "license": "AGPL-3.0",
  "scripts": {
    "build": "npm run build --prefix scripts/bundle",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:types": "node scripts/build-types.mjs",
    "lint": "oxlint",
    "typecheck": "node scripts/sync-vendor-types.mjs && tsc --noEmit",
    "prepare": "node scripts/sync-vendor-types.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:consumer": "tsc -p test/fixtures/ts-consumer/tsconfig.json",
    "check:ci": "npm run lint && npm run typecheck && npm run build:sdk && npm run check:size && npm run check:consumer && npm test",
    "test": "node --test test/engine-node.test.js test/handoff-node.test.js test/relay-node.test.js && web-test-runner --node-resolve"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  }
}